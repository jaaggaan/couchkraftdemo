# Copy to .env and fill with Razorpay Dashboard → Test Mode API keys.
# Never use rzp_live_ keys in this project without explicit approval.

RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourKeySecret

# Server-only Supabase configuration. Never expose SUPABASE_SERVICE_ROLE_KEY
# to browser code or VITE_* environment variables.
SUPABASE_URL=https://your-project.supabase.co
# Use the Supabase secret key (sb_secret_...), not the publishable (sb_publishable_...) key.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Required for signing and validating customer session cookies.
COUCHKRAFT_AUTH_SECRET=change-me-in-local-dev

# Set to true only for the intended CouchKraft demo deployment.
COUCHKRAFT_DEMO_LOGIN_ENABLED=false

# UPI QR / intent links on the YouPI-style payment step (optional overrides).
COUCHKRAFT_UPI_VPA=your-merchant@oksbi
COUCHKRAFT_UPI_PAYEE_NAME=CouchKraft

# Browser-safe Supabase (storefront + admin builds). Use the publishable anon key only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional: admin product images when admin runs on a different origin than the shop.
# VITE_STOREFRONT_URL=https://your-domain.vercel.app
